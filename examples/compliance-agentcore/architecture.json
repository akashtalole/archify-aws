{
  "meta": {
    "title": "Compliance review assistant on Amazon Bedrock AgentCore",
    "subtitle": "A supervisor agent delegates check families to specialist agents; every tool call passes Gateway and Policy; flagged checks wait for a human, and the final decision is blocked until a reviewer has approved",
    "lens": [
      "framework",
      "generative-ai"
    ],
    "output": "examples/compliance-agentcore/out/architecture.html",
    "cost": {
      "note": "Illustrative volumes: 2,000 documents/month, 40 pages each, 100 checks per document. Replace usage on each node with your actuals."
    }
  },
