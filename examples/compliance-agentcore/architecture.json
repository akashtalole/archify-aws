  "edges": [
    {
      "from": "owners",
      "to": "apigw",
      "step": 1,
      "label": "upload",
      "desc": "An owner signs in through the corporate IdP and uploads a document with the check set to apply."
    },
    {
      "from": "waf",
      "to": "apigw",
      "style": "dashed",
      "label": "protects"
    },
    {
      "from": "cognito",
      "to": "apigw",
      "style": "dashed",
      "label": "authorizer"
    },
    {
      "from": "apigw",
      "to": "intake",
      "step": 2,
      "label": "presigned upload",
      "desc": "The document lands in the KMS-encrypted intake bucket."
    },
    {
      "from": "intake",
      "to": "platform",
      "step": 3,
      "label": "invoke agent",
      "desc": "An EventBridge rule on the upload invokes the supervisor on AgentCore Runtime with a run id."
    },
    {
      "from": "sup",
      "to": "chk",
      "step": 4,
      "label": "delegate (A2A)",
      "desc": "The supervisor splits the 100 checks into families and delegates each family to a specialist agent in parallel."
    },
    {
      "from": "chk",
      "to": "gw",
      "step": 5,
      "label": "tool calls (MCP)",
      "desc": "Agents reach every tool through Gateway; nothing is called directly."
    },
    {
      "from": "pol",
      "to": "gw",
      "style": "dashed",
      "label": "authorize each call"
    },
    {
      "from": "platform",
      "to": "models",
      "step": 6,
      "label": "invoke",
      "desc": "Agents judge each check against retrieved criteria, with citations; Guardrails screen input and output."
    },
    {
      "from": "platform",
      "to": "data",
      "step": 7,
      "label": "MCP targets",
      "desc": "Gateway fronts text extraction, the policy library, verdict storage and the evidence bucket."
    },
    {
      "from": "platform",
      "to": "review",
      "step": 8,
      "label": "flag + resume",
      "desc": "Flagged checks are queued with cited evidence. The run checkpoints its state and ends; a reviewer's decision resumes it, so a slow reviewer never holds a session open.",
      "arrow": "both"
    },
    {
      "from": "review",
      "to": "reviewers",
      "step": 9,
      "arrow": "both",
      "label": "task and decision"
    }
  ]
}