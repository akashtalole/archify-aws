          {
            "id": "shoppers",
            "icon": "users",
            "label": "Shoppers",
            "sublabel": "web and app"
          },
          {
            "id": "merch",
            "icon": "users",
            "label": "Merchandisers",
            "sublabel": "synonyms, boosts"
