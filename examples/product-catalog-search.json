{
  "meta": {
    "title": "Enterprise product catalog search on AWS",
    "subtitle": "Hybrid keyword + semantic search over a product catalog: a cached edge, a thin search API, OpenSearch for retrieval, Bedrock embeddings for meaning, and an event-driven pipeline that keeps the index fresh",
    "lens": [
      "framework"
    ],
    "output": "examples/out/product-catalog-search.html",
    "workload": {
      "name": "Product catalog search",
      "criticality": "high",
      "description": "Customer-facing search across ~2M SKUs with near-real-time catalog updates"
    },
    "cost": {
      "note": "Illustrative: 10M searches/month, 2M products, ~300,000 catalog updates/day re-embedded (~120 tokens each), 3-node OpenSearch cluster across 3 AZs. CloudFront, Firehose, Athena and Personalize are not priced yet. Replace usage on each node with your actuals."
    }
  },
  "root": {
    "layout": "row",
    "gap": 80,
    "children": [
      {
        "id": "people",
        "kind": "stack",
        "layout": "column",
