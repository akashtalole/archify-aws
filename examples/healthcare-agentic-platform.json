  "edges": [
    {
      "from": "staff",
      "to": "apigw",
      "step": 1,
      "label": "HTTPS",
      "desc": "Staff reach agent apps through the WAF-protected API; sessions are federated from the hospital IdP."
    },
    {
      "from": "idc",
      "to": "apigw",
      "style": "dashed",
      "label": "OIDC / SSO"
    },
    {
      "from": "waf",
      "to": "apigw",
      "style": "dashed",
      "label": "protects"
    },
    {
      "from": "apigw",
      "to": "agentcore",
      "step": 2,
      "desc": "Authenticated request starts an agent session with the caller's identity propagated."
    },
    {
      "from": "agentcore",
      "to": "guard",
      "step": 3,
      "label": "screen I/O",
      "desc": "Guardrails filter prompts and responses (PHI/PII handling, harmful content, prompt attacks)."
    },
    {
      "from": "agentcore",
      "to": "avp",
      "step": 4,
      "label": "authorize",
      "desc": "Each tool call is authorized against least-privilege policies (role, patient relationship, purpose)."
    },
    {
      "from": "agentcore",
      "to": "models",
      "step": 5,
      "label": "invoke",
      "desc": "The agent reasons with foundation models and calls clinical AI services as tools."
    },
    {
      "from": "agentcore",
      "to": "data",
      "step": 6,
      "label": "tools + RAG",
      "desc": "Tools read FHIR records and retrieve grounded knowledge; results return through the guardrails."
    },
    {
      "from": "agentcore",
      "to": "ops",
      "style": "dashed",
      "label": "telemetry + audit"
    },
    {
      "from": "data",
      "to": "dx",
      "arrow": "both",
      "style": "dashed",
      "label": "FHIR / HL7"
    },
    {
      "from": "dx",
      "to": "onprem",
      "arrow": "both",
      "style": "dashed"
    }
  ]
