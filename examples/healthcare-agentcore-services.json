      "to": "apigw",
      "style": "dashed",
      "label": "protects"
    },
    {
      "from": "apigw",
      "to": "uc",
      "step": 2,
      "label": "invoke agent",
      "desc": "Each use case is a separate agent with its own identity, scope and release cycle."
    },
    {
      "from": "uc",
      "to": "platform",
      "step": 3,
      "label": "deploy",
      "desc": "Agents (Strands, LangGraph, CrewAI or Harness) run on AgentCore Runtime in isolated sessions."
    },
    {
      "from": "runtime",
      "to": "gateway",
      "step": 4,
      "label": "tool calls",
      "desc": "Agents reach tools only via Gateway, which exposes APIs and Lambda as MCP tools."
    },
