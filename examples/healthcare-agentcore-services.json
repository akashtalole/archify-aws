      "from": "policy",
      "to": "gateway",
      "style": "dashed",
      "label": "authorizes each call"
    },
    {
      "from": "platform",
      "to": "tools",
      "step": 5,
      "label": "MCP tools",
      "desc": "Gateway fronts business APIs, FHIR data and knowledge bases."
    },
    {
      "from": "platform",
      "to": "models",
      "step": 6,
      "label": "invoke models",
      "desc": "Models are called through Bedrock with Guardrails on input and output."
