{
  "name": "archify-aws",
  "version": "0.1.0",
  "description": "Generate AWS architecture diagrams (standalone SVG/HTML) from typed JSON using the official AWS Architecture Icons, with Well-Architected review hints. Companion to tt-a1i/archify.",
  "type": "module",
  "license": "MIT",
  "bin": { "archify-aws": "bin/archify-aws.mjs" },
  "engines": { "node": ">=20" },
  "scripts": {
    "icons:fetch": "node scripts/fetch-icons.mjs",
    "prices:fetch": "node scripts/fetch-prices.mjs",
    "wa:corpus": "node scripts/build-wa-corpus.mjs",
    "drawio:map": "node scripts/build-drawio-map.mjs",
    "examples": "node scripts/build-examples.mjs",
    "schemas": "node scripts/build-schemas.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
